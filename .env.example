# ══════════════════════════════════════════════════
# VARIABLES DE ENTORNO - PRODUCCIÓN (Vercel)
# ══════════════════════════════════════════════════
# Copia estas variables en el panel de Vercel:
# Project > Settings > Environment Variables

# ── Base de datos (Neon PostgreSQL) ───────────────
# Obtén estas URLs desde: https://console.neon.tech (o desde la integración
# Vercel > Storage > Neon si la creas directamente desde Vercel)
DATABASE_URL="postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.eu-west-1.aws.neon.tech/neondb?sslmode=require"

# ── Stripe ────────────────────────────────────────
# Claves: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
# Webhook secret: https://dashboard.stripe.com/webhooks
# Endpoint a registrar: https://tu-dominio.com/api/bookings/webhook
# Evento a escuchar: checkout.session.completed
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Email Gmail ───────────────────────────────────
# App Password: https://myaccount.google.com/apppasswords
