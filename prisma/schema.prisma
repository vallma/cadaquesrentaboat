generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// A boat is a single physical unit — unlike a diving activity with N slots
// per session, a boat can only ever have one booking per date+period.
model Boat {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  type            String // llanxa | llaut | semirrigida
  location        String
  capacity        Int
  hp              Int
  lengthM         Float
  licenseRequired Boolean
  fuelIncluded    String // "included" | "not_included" | "zone_included"
  priceHalfDay    Float
  priceFullDay    Float
  skipperHalfDay  Float    @default(100)
  skipperFullDay  Float    @default(180)
  securityDeposit Float? // "fiança" — informational, not charged online
  imageUrl        String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings Booking[]
}

model Booking {
  id         String   @id @default(cuid())
  bookingRef String   @unique
  boatId     String
  date       DateTime // day only, time component ignored
  period     String // HALF_DAY | FULL_DAY
  status     String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | CONFIRMED | CANCELLED

  withSkipper     Boolean @default(false)
  boatPrice       Float
  skipperPrice    Float   @default(0)
  totalPrice      Float
  depositPaid     Float // the 20% actually charged via Stripe
  remainingAmount Float
  securityDeposit Float? // copied from Boat at booking time, informational

  customerName   String
  customerEmail  String
  customerPhone  String
  customerLocale String  @default("ca")
  notes          String?

  stripeSessionId String?
  stripePaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boat Boat @relation(fields: [boatId], references: [id])

  @@index([boatId, date])
}
